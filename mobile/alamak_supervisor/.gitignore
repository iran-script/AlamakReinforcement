# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Android SDK and generated Gradle state
/android/local.properties
/android/.gradle/
/android/build/
/android/app/build/

# Signing material and generated install packages
/cls
/curl.exe
*.jks
*.keystore
*.p12
*.pfx
*.apk
*.aab
*.pem
*.key

# The portable Maven repository can contain large downloaded artifacts.
# Keep only its installer and documentation; never stage cached JAR/AAR files.
/android/maven-offline/*
!/android/maven-offline/Import-VerifiedMavenRepository.ps1
!/android/maven-offline/MISSING-DEPENDENCIES.csv
!/android/maven-offline/TRANSFER-GUIDE.md

# Widget Preview related
.widget_preview/
